---
import Header from '../components/Header.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { description as defaultDescription } from '../site';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	showHeader?: boolean;
}

const {
	title,
	description = defaultDescription,
	showHeader = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var theme = stored === 'light' || stored === 'dark'
						? stored
						: (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					document.documentElement.classList.toggle('dark', theme === 'dark');
				} catch (e) {}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:site_name" content="Jeremiah Iromaka" />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&display=swap" rel="stylesheet" />
	</head>
	<body>
		<a href="#content" class="skip-link">Skip to content</a>
		<div class="relative flex min-h-dvh flex-col">
			<ThemeToggle class="absolute right-2 top-2 z-20 md:right-6 md:top-5" />
			{showHeader && <Header class="absolute top-6 z-10 w-full pe-16 text-sm md:top-7 md:pe-24" />}
			<main id="content" tabindex="-1" class="flex flex-1 flex-col outline-none">
				<section class="wrapper flex flex-1 flex-col">
					<slot />
				</section>
			</main>
		</div>
	</body>
</html>
<style is:global>
	html {
		font-family: 'League Spartan', system-ui, sans-serif;
		color-scheme: light;
		@apply bg-slate-100 text-slate-900 antialiased;
	}
	html.dark {
		color-scheme: dark;
		@apply bg-slate-900 text-slate-100;
	}
	.skip-link {
		position: absolute;
		left: 1rem;
		top: 1rem;
		z-index: 40;
		transform: translateY(-200%);
		border-radius: 0.25rem;
		background: #0f172a;
		color: #f8fafc;
		padding: 0.5rem 0.75rem;
	}
	.skip-link:focus {
		transform: none;
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	html.dark .skip-link {
		background: #f8fafc;
		color: #0f172a;
	}
</style>
