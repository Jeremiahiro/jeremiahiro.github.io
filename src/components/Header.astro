---
interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;
const pathname = Astro.url.pathname;
const onResume = pathname === '/resume' || pathname === '/resume/';

const linkClass =
	'rounded-sm underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-slate-900 dark:focus-visible:outline-slate-100';
---

<nav class={className} aria-label="Site">
	<div class="mx-auto flex w-full max-w-screen-xl justify-end px-4 py-3">
		<ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 font-light leading-6 text-slate-700 dark:text-slate-300">
			<li>
				<a href="/" class={linkClass} aria-current={pathname === '/' ? 'page' : undefined}>
					<span class="hidden sm:inline">Jeremiah Iromaka</span>
					<span class="sm:hidden">JI</span>
				</a>
			</li>
			<li>
				<a href="https://about.me/jeremiahiro" class={linkClass} target="_blank" rel="noopener noreferrer">
					About<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</li>
			<li>
				<a href="/resume" class={linkClass} aria-current={onResume ? 'page' : undefined}>Resume</a>
			</li>
			<li>
				<a href="https://github.com/jeremiahiro" class={linkClass} target="_blank" rel="noopener noreferrer">
					GitHub<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</li>
			<li>
				<a href="https://www.linkedin.com/in/jeremiahiro/" class={linkClass} target="_blank" rel="noopener noreferrer">
					LinkedIn<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</li>
		</ul>
	</div>
</nav>
